# Required credential. Keep the real value in an untracked .env file.
GOOGLE_API_KEY=

# Verified defaults. Other supported Google model IDs can be substituted.
GENERATION_MODEL=gemma-4-26b-a4b-it
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Paths are resolved relative to this project directory.
PDF_STORAGE_PATH=data/pdfs
VECTOR_STORE_PATH=data/vector_store

# Public benchmark baseline. Use the sweep script before changing a quality claim.
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
TOP_K=4
MAX_QUESTION_CHARS=2000
